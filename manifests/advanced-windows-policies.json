{
  "schemaVersion": 1,
  "tweaks": [
    {
      "id": "gaming.game-mode.enable",
      "name": "Enable Windows Game Mode",
      "category": "gaming",
      "tier": "verified",
      "description": "Lets Windows prioritize the foreground game and reduce background update activity while playing.",
      "impact": "Uses the supported Windows gaming preference instead of undocumented scheduler changes.",
      "source": "https://support.microsoft.com/windows/use-game-mode-while-gaming-on-your-windows-device-5c94107e-a537-49c0-bf3f-4076d7a78a07",
      "requires": { "minBuild": 19041 },
      "detect": [{ "type": "registry", "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "equals": 1 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "valueType": "dword", "value": 1 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled" }],
      "reboot": false
    },
    {
      "id": "gaming.game-dvr-policy.disable",
      "name": "Disable Game DVR recording by policy",
      "category": "gaming",
      "tier": "situational",
      "audience": "simple",
      "description": "Disables Windows Game DVR recording at machine-policy level, beyond the current-user capture switch.",
      "impact": "Prevents background and manual Game DVR recording for all users.",
      "tradeoff": "Windows game clips and Game Bar recording will be unavailable until this policy is reverted.",
      "source": "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-applicationmanagement#allowgamedvr",
      "requires": { "minBuild": 19041, "editions": ["Pro", "Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR", "equals": 0 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR", "valueType": "dword", "value": 0 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR" }],
      "reboot": false
    },
    {
      "id": "privacy.consumer-experiences.disable",
      "name": "Disable Microsoft consumer experiences",
      "category": "privacy",
      "tier": "situational",
      "audience": "advanced",
      "description": "Applies the documented Cloud Content policy that blocks consumer app and content suggestions.",
      "impact": "Reduces suggested consumer content provisioned by Windows.",
      "tradeoff": "Some editions may ignore this policy, and Windows recommendations become less personalized.",
      "source": "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-experience#allowwindowsconsumerfeatures",
      "requires": { "minBuild": 19041, "editions": ["Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "equals": 1 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "valueType": "dword", "value": 1 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures" }],
      "reboot": false
    },
    {
      "id": "privacy.feedback-notifications.disable",
      "name": "Disable Windows feedback prompts",
      "category": "privacy",
      "tier": "situational",
      "description": "Stops Windows from asking the signed-in user for diagnostic feedback.",
      "impact": "Removes periodic feedback requests without uninstalling Feedback Hub.",
      "tradeoff": "Windows will no longer prompt this account to rate experiences or submit feedback.",
      "source": "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-experience#donotshowfeedbacknotifications",
      "requires": { "minBuild": 19041, "editions": ["Pro", "Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "equals": 1 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "valueType": "dword", "value": 1 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications" }],
      "reboot": false
    },
    {
      "id": "privacy.diagnostic-data.required-only",
      "name": "Limit diagnostic data to required",
      "category": "privacy",
      "tier": "situational",
      "audience": "simple",
      "description": "Requests the documented Required diagnostic-data level instead of claiming telemetry can be fully disabled.",
      "impact": "Limits optional diagnostic collection on Windows editions that honor the policy.",
      "tradeoff": "Required service data still reaches Microsoft; edition and organization policy can override this setting.",
      "source": "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-system#allowtelemetry",
      "requires": { "minBuild": 19041, "editions": ["Pro", "Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "equals": 1 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "valueType": "dword", "value": 1 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry" }],
      "reboot": false
    },
    {
      "id": "explorer.compact-mode.enable",
      "name": "Use compact File Explorer spacing",
      "category": "explorer",
      "tier": "situational",
      "description": "Reduces vertical padding in File Explorer for a denser file list.",
      "impact": "Shows more files at once without changing file behavior.",
      "tradeoff": "Touch targets become smaller and can be less comfortable on tablets.",
      "source": "https://github.com/Raphire/Win11Debloat/blob/master/Regfiles/Use_Compact_Mode_File_Explorer.reg",
      "requires": { "minBuild": 22000 },
      "detect": [{ "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "UseCompactMode", "equals": 1 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "UseCompactMode", "valueType": "dword", "value": 1 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "UseCompactMode" }],
      "reboot": false
    },
    {
      "id": "system.startup-delay.disable",
      "name": "Remove Explorer startup delay",
      "category": "system",
      "tier": "situational",
      "audience": "advanced",
      "description": "Sets Explorer's per-user StartupDelayInMSec value to zero for startup application launch.",
      "impact": "Startup applications can begin sooner after sign-in.",
      "tradeoff": "Starting everything immediately can increase the short CPU and disk spike after sign-in on slower PCs.",
      "source": "https://github.com/ChrisTitusTech/winutil/blob/main/config/tweaks.json",
      "requires": { "minBuild": 19041 },
      "detect": [{ "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "equals": 0 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "valueType": "dword", "value": 0 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec" }],
      "reboot": false
    },
    {
      "id": "system.menu-delay.reduce",
      "name": "Reduce desktop menu delay",
      "category": "system",
      "tier": "situational",
      "audience": "advanced",
      "description": "Reduces the current user's menu hover delay to 100 milliseconds.",
      "impact": "Menus respond sooner to pointer hover.",
      "tradeoff": "Submenus may open before you intend when moving the pointer across a menu.",
      "source": "https://github.com/farag2/Sophia-Script-for-Windows",
      "requires": { "minBuild": 19041 },
      "detect": [{ "type": "registry", "path": "HKCU\\Control Panel\\Desktop", "name": "MenuShowDelay", "equals": "100" }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKCU\\Control Panel\\Desktop", "name": "MenuShowDelay", "valueType": "string", "value": "100" }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKCU\\Control Panel\\Desktop", "name": "MenuShowDelay" }],
      "reboot": false
    },
    {
      "id": "update.driver-updates.exclude",
      "name": "Exclude drivers from Windows quality updates",
      "category": "update",
      "tier": "situational",
      "audience": "advanced",
      "description": "Uses the Windows Update policy that excludes driver packages from normal quality updates.",
      "impact": "Prevents Windows Update from replacing a deliberately managed GPU or device driver during quality updates.",
      "tradeoff": "You become responsible for installing important driver and firmware updates from Windows Update or the device vendor.",
      "source": "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-update#excludewudriversinqualityupdate",
      "requires": { "minBuild": 19041, "editions": ["Pro", "Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate", "equals": 1 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate", "valueType": "dword", "value": 1 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate" }],
      "reboot": false
    },
    {
      "id": "update.no-auto-restart.logged-on",
      "name": "Prevent update restart while signed in",
      "category": "update",
      "tier": "situational",
      "audience": "advanced",
      "description": "Configures scheduled updates not to restart automatically while a user is signed in.",
      "impact": "Avoids a forced restart interrupting an active session.",
      "tradeoff": "A machine whose users rarely sign out can postpone a security-update restart for too long; you must restart it manually.",
      "source": "https://learn.microsoft.com/windows/deployment/update/waas-restart",
      "requires": { "minBuild": 19041, "editions": ["Pro", "Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers", "equals": 1 }],
      "apply": [
        { "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "AUOptions", "valueType": "dword", "value": 4 },
        { "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers", "valueType": "dword", "value": 1 }
      ],
      "revert": [
        { "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "AUOptions" },
        { "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers" }
      ],
      "reboot": false
    },
    {
      "id": "system.background-apps.policy-disable",
      "name": "Disable Store apps in the background",
      "category": "system",
      "tier": "aggressive",
      "audience": "advanced",
      "description": "Forces the Windows app-privacy policy to deny background execution for packaged apps.",
      "impact": "Can reduce idle activity from Store apps that would otherwise run in the background.",
      "tradeoff": "Notifications, sync, alarms, calls, and background refresh from affected apps can stop working.",
      "source": "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-privacy#letappsruninbackground",
      "requires": { "minBuild": 19041, "editions": ["Pro", "Enterprise", "Education"] },
      "detect": [{ "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy", "name": "LetAppsRunInBackground", "equals": 2 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy", "name": "LetAppsRunInBackground", "valueType": "dword", "value": 2 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy", "name": "LetAppsRunInBackground" }],
      "reboot": false
    },
    {
      "id": "gaming.memory-integrity.disable",
      "name": "Disable Memory Integrity",
      "category": "gaming",
      "tier": "aggressive",
      "audience": "advanced",
      "description": "Turns off Hypervisor-protected Code Integrity through its documented Device Guard registry state.",
      "impact": "May recover performance on some older processors or incompatible driver stacks.",
      "tradeoff": "This removes a major kernel security boundary. It is never recommended or preselected and should only be used after measuring a real issue.",
      "source": "https://learn.microsoft.com/windows-hardware/design/device-experiences/oem-hvci-enablement",
      "requires": { "minBuild": 19041 },
      "detect": [{ "type": "registry", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity", "name": "Enabled", "equals": 0 }],
      "apply": [{ "type": "registry", "action": "set", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity", "name": "Enabled", "valueType": "dword", "value": 0 }],
      "revert": [{ "type": "registry", "action": "delete", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity", "name": "Enabled" }],
      "reboot": true
    }
  ]
}
