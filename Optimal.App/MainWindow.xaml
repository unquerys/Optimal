<Window x:Class="Optimal.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Optimal.App" Title="Optimal" Width="1260" Height="800" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource CanvasBrush}" Icon="Assets/Optimal Symbol.png" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed" TextOptions.TextRenderingMode="ClearType" Loaded="Window_Loaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolVisibility" />
      <DataTemplate x:Key="TweakCardTemplate">
        <Border Width="438" Margin="0,0,12,12" Padding="18" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Column="0" Margin="0,0,24,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" Text="{Binding Category}" />
                <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding Tier}" Foreground="{Binding TierBrush}" />
                <Border Background="#2B214A" CornerRadius="4" Padding="6,2" Margin="9,-2,0,-2" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="ADVANCED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource PurpleBrush}" />
                </Border>
                <TextBlock Text="  ·  RESTART" FontSize="10" Foreground="{StaticResource PurpleBrush}" Visibility="{Binding Reboot, Converter={StaticResource BoolVisibility}}" />
              </StackPanel>
              <TextBlock Grid.Row="1" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding Name}" />
              <TextBlock Grid.Row="2" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Description}" />
              <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                <TextBlock FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" Text="{Binding State}" Foreground="{Binding StateBrush}" />
                <Button Content="View source" FontSize="9" Padding="8,3" Margin="10,-4,0,-4" Style="{StaticResource GhostButton}" Tag="{Binding Source}" Click="OpenSource_Click" />
              </StackPanel>
              <Border Grid.Row="4" Background="#161D2D" CornerRadius="7" Padding="9" Margin="0,12,0,0" Visibility="{Binding HasTradeoff, Converter={StaticResource BoolVisibility}}">
                <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Text="{Binding Tradeoff}" />
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
              <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="PlanRowTemplate">
        <Border BorderThickness="0,0,0,1" Padding="0,14" BorderBrush="{StaticResource BorderBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" />
              <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,16,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Detail}" />
            </StackPanel>
            <Border Grid.Column="1" Background="#172230" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
              <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
            </Border>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="SoftwareCardTemplate">
        <Border Width="438" Margin="0,0,12,12" Padding="18" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
              <Border CornerRadius="11" Background="{Binding BrandBrush}">
                <TextBlock FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="{Binding BrandGlyph}" />
              </Border>
              <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding LogoPath}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="8,0,18,0">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
              <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Description}" />
              <TextBlock Text="Exact WinGet package · review before install" FontSize="9" Margin="0,9,0,0" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <CheckBox Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource ToggleStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderBrush="#263246" BorderThickness="1" CornerRadius="12" Background="{StaticResource CanvasBrush}">
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#0A0F17" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Source="Assets/Optimal Symbol.png" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="OPTIMAL" Margin="9,0,0,0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
          <Border Margin="10,0,0,0" Background="#172131" CornerRadius="5" Padding="6,2">
            <TextBlock Text="STABLE" FontSize="9" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
          </Border>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Background="#101722" BorderBrush="#263246" BorderThickness="1" CornerRadius="7" Padding="3">
          <StackPanel Orientation="Horizontal">
            <Button Name="SimpleModeButton" Content="SIMPLE" Tag="simple" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="12,5" ToolTip="Clear, broadly understandable controls" Click="CatalogMode_Click" />
            <Button Name="AdvancedModeButton" Content="ADVANCED" Tag="advanced" Style="{StaticResource GhostButton}" FontSize="9" Padding="12,5" ToolTip="Policy, registry, and expert controls with tradeoffs" Click="CatalogMode_Click" />
          </StackPanel>
        </Border>
        <Button Grid.Column="1" Content="" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource GhostButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
        <Button Grid.Column="2" Content="" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource GhostButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" />
        <Button Grid.Column="3" Content="" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource GhostButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
      </Grid>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="218" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#1D2838" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="20,24,20,22">
              <TextBlock Text="CONTROL CENTER" Foreground="#64748A" FontSize="9" FontWeight="Bold" />
              <TextBlock Text="Tune with confidence." FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="Simple mode is active by default." Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1">
              <Button Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Home" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="OptimizeNav" Style="{StaticResource NavButton}" Click="OptimizeNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Tweaks" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="GamingNav" Style="{StaticResource NavButton}" Click="GamingNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Gaming" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="AppsNav" Style="{StaticResource NavButton}" Click="AppsNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Software" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="MaintenanceNav" Style="{StaticResource NavButton}" Click="MaintenanceNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Maintenance" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="NetworkNav" Style="{StaticResource NavButton}" Click="NetworkNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Networking" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="ModulesNav" Style="{StaticResource NavButton}" Click="ModulesNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Advanced" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="RestoreNav" Style="{StaticResource NavButton}" Click="RestoreNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="System Restore" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="HistoryNav" Style="{StaticResource NavButton}" Click="HistoryNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="Run history" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="SystemNav" Style="{StaticResource NavButton}" Click="SystemNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="This PC" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Name="AboutNav" Style="{StaticResource NavButton}" Click="AboutNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" />
                  <TextBlock Text="About" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Border Grid.Row="3" Margin="14" Padding="14" Background="#101925" CornerRadius="11" BorderBrush="#1E2A3B" BorderThickness="1">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Name="EngineDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                  <TextBlock Name="EngineStatusText" Text="INITIALIZING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Name="SidebarMachineText" Text="Reading this PC…" FontSize="11" Foreground="#8391A5" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Column="1">
          <Grid Name="HomePage">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid MaxWidth="960" Margin="44,34,44,34">
                <StackPanel>
                  <Grid>
                    <StackPanel>
                      <TextBlock Text="SYSTEM OVERVIEW" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                      <TextBlock Text="Your PC, clearly." FontSize="32" FontWeight="SemiBold" Margin="0,7,0,0" />
                      <TextBlock Text="Read-only diagnostics first. You decide what happens next." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Content="Review opportunities  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OptimizeNav_Click" />
                  </Grid>
                  <UniformGrid Columns="4" Margin="0,28,0,0">
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,7,0">
                      <StackPanel HorizontalAlignment="Center">
                        <local:RadialMetric x:Name="CpuGauge" Caption="CPU" Accent="{StaticResource AccentBrush}" />
                        <TextBlock Name="CpuMetricDetail" Text="Reading processor" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="7,0">
                      <StackPanel HorizontalAlignment="Center">
                        <local:RadialMetric x:Name="GpuGauge" Caption="GPU" Accent="{StaticResource PurpleBrush}" />
                        <TextBlock Name="GpuMetricDetail" Text="Reading graphics" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="7,0">
                      <StackPanel HorizontalAlignment="Center">
                        <local:RadialMetric x:Name="MemoryGauge" Caption="Memory" Accent="{StaticResource SuccessBrush}" />
                        <TextBlock Name="MemoryMetricDetail" Text="Reading memory" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="7,0,0,0">
                      <StackPanel HorizontalAlignment="Center">
                        <local:RadialMetric x:Name="StorageGauge" Caption="Storage" Accent="{StaticResource WarningBrush}" />
                        <TextBlock Name="StorageMetricDetail" Text="Reading system drive" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                  <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,18,0,0" Background="{StaticResource HeroGradient}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Image Source="Assets/Optimal Symbol.png" Width="52" Height="52" Stretch="Uniform" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Name="HardwareProfileTitle" Text="Building hardware profile…" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Name="HardwareProfileText" Text="Matching CPU, GPU, thermals, and device type." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0" />
                        <TextBlock Name="TemperatureText" Text="TEMPERATURE · waiting for driver sensor" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="Bold" Margin="0,9,0,0" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="Open Gaming" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="GamingNav_Click" />
                    </Grid>
                  </Border>
                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.35*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,9,0">
                      <StackPanel>
                        <TextBlock Text="OPPORTUNITIES" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Name="OpportunityText" Text="Validating compatible changes…" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Recommendations never apply automatically. Open the catalog to inspect source, tradeoffs, current state, and undo behavior." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,18" />
                        <Button Content="Open tweak catalog" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OptimizeNav_Click" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22" Margin="9,0,0,0">
                      <StackPanel>
                        <TextBlock Text="QUICK ACCESS" Foreground="{StaticResource PurpleBrush}" FontSize="9" FontWeight="Bold" />
                        <Button Content="Temporary files" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Tag="ms-settings:storagesense" Margin="-12,8,-12,0" Click="OpenWindowsTool_Click" />
                        <Button Content="Network status" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Tag="ms-settings:network-status" Margin="-12,0,-12,0" Click="OpenWindowsTool_Click" />
                        <Button Content="Graphics settings" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Tag="ms-settings:display-advancedgraphics" Margin="-12,0,-12,0" Click="OpenWindowsTool_Click" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock Text="TOOLS" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12" />
                  <UniformGrid Columns="3">
                    <Button Content="Maintenance" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="MaintenanceNav_Click" />
                    <Button Content="Network diagnostics" Style="{StaticResource SecondaryButton}" Margin="8,0" Click="NetworkNav_Click" />
                    <Button Content="Performance lab" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ModulesNav_Click" />
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
          <Grid Name="OptimizePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="82" />
            </Grid.RowDefinitions>
            <ScrollViewer Name="OptimizeScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid MaxWidth="930" Margin="44,34,44,28">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="OPTIMIZE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Make Windows feel lighter." FontSize="32" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock Text="Every change is detected, explained, backed up, and reversible." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,20,0,0">
                      <Button Content="STANDARD" Tag="standard" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,8" Click="Preset_Click" />
                      <Button Content="MINIMAL" Tag="minimal" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,8" Click="Preset_Click" />
                      <Button Content="PRIVACY" Tag="privacy" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,8" Click="Preset_Click" />
                      <Button Content="PERFORMANCE" Tag="performance" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,8" Click="Preset_Click" />
                      <Button Content="AUTO DEBLOAT" Tag="debloat" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,8" Click="Preset_Click" />
                    </WrapPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,12" VerticalAlignment="Center">
                    <StackPanel>
                      <TextBlock Name="HeroOsText" Text="Scanning Windows…" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Name="HeroHardwareText" Text="Hardware profile pending" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Row="1" Margin="0,28,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <TextBox Name="SearchBox" FontSize="13" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="Search tweaks…" Foreground="#66758A" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Value="" Binding="{Binding Text, ElementName=SearchBox}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                  <ComboBox Name="CategoryFilter" Grid.Column="1" Margin="12,0,0,0" SelectedIndex="0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10,8" SelectionChanged="CategoryFilter_SelectionChanged" />
                </Grid>
                <Grid Row="2" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Name="CatalogSummaryText" Text="Loading catalog…" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="RECOMMENDED" Style="{StaticResource GhostButton}" FontSize="9" Click="Recommended_Click" />
                    <Button Content="CLEAR" Style="{StaticResource GhostButton}" FontSize="9" Click="Clear_Click" />
                  </StackPanel>
                </Grid>
                <ItemsControl Grid.Row="3" ItemTemplate="{StaticResource TweakCardTemplate}" ItemsSource="{Binding TweakView}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Background="#0D131D" BorderBrush="#1D2939" BorderThickness="0,1,0,0">
              <Grid MaxWidth="930" Margin="44,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Name="SelectionText" Text="0 tweaks selected" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="Nothing changes until you review and confirm." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
                <Button Name="ReviewButton" Grid.Column="1" Content="Review plan  →" Style="{StaticResource PrimaryButton}" IsEnabled="False" VerticalAlignment="Center" Click="Review_Click" />
              </Grid>
            </Border>
          </Grid>
          <Grid Name="ReviewPage" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid MaxWidth="870" Margin="48,38">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <Button Content="←  Back to tweaks" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,0,0,12" Click="BackToTweaks_Click" />
                  <TextBlock Text="Review before applying." FontSize="30" FontWeight="SemiBold" />
                  <TextBlock Name="ReviewSummaryText" Text="Building an exact plan…" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                </StackPanel>
                <Grid Row="1" Margin="0,28,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,16,0">
                    <StackPanel>
                      <TextBlock Text="CHANGE SET" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                      <ItemsControl ItemTemplate="{StaticResource PlanRowTemplate}" Margin="0,8,0,0" ItemsSource="{Binding PlanRows}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1">
