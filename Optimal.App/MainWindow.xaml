                        <TextBlock Text="Game Mode, graphics preference, controller diagnostics, and per-game profiles. Controller overclocking remains an advanced external workflow with warnings." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="Gaming settings" Style="{StaticResource SecondaryButton}" Tag="ms-settings:gaming-gamemode" Click="OpenWindowsTool_Click" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="9,9,0,0">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="BIOS recommendations" FontSize="18" FontWeight="SemiBold" />
                          <Border Background="#392718" CornerRadius="5" Padding="7,3" Margin="10,0,0,0">
                            <TextBlock Text="READ ONLY" Foreground="{StaticResource WarningBrush}" FontSize="9" FontWeight="Bold" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="Hardware-specific diagnosis and education only. Optimal will never flash firmware or silently change BIOS values." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="System information" Style="{StaticResource SecondaryButton}" Tag="msinfo32.exe" Click="OpenWindowsTool_Click" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,18,9,0">
                      <StackPanel>
                        <TextBlock Text="RAM &amp; GPU validation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Validate temperatures, clocks, VRAM pressure, memory stability, and driver latency before changing clocks. Cache cleaners and forced standby-list purges are intentionally excluded." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                        <WrapPanel>
                          <Button Content="Select GPU-Z" Style="{StaticResource SecondaryButton}" Tag="apps.gpuz.install" Margin="0,0,8,8" Click="SelectTweak_Click" />
                          <Button Content="Memory Diagnostic" Style="{StaticResource GhostButton}" Tag="mdsched.exe" Click="OpenWindowsTool_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="9,18,0,0" Background="{StaticResource HeroGradient}">
                      <StackPanel>
                        <TextBlock Text="Hardware latency workflow" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Measure DPC/ISR latency under a repeatable workload, identify the responsible driver, update or roll back that device, then retest. Optimal does not sell a magic timer preset." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="Select LatencyMon" Style="{StaticResource PrimaryButton}" Tag="apps.latencymon.install" Click="SelectTweak_Click" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                  <Border Background="#211C10" BorderBrush="#493B1D" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,18,0,0">
                    <TextBlock Text="Overclocking guidance is educational and vendor-specific: establish a thermal baseline, change one variable, stress-test, and keep a recovery path. Optimal will not write CPU voltage, GPU VBIOS, RAM timings, firmware, HPET/BCD timer flags, or undocumented interrupt masks." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
          <Grid Name="RestorePage" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid MaxWidth="930" Margin="44,34">
                <StackPanel>
                  <TextBlock Text="SYSTEM RESTORE" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Restore points, without the mystery." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" />
                  <TextBlock Text="Create a named checkpoint and restore individual Optimal runs from their captured state." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                  <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.35*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,9,0">
                      <StackPanel>
                        <Grid>
                          <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/Optimal Symbol.png" Width="32" Height="32" Margin="0,0,12,0" />
                            <TextBlock Text="Create restore point" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                          <Button Content="Create  +" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="CreateRestorePoint_Click" />
                        </Grid>
                        <TextBox Name="RestoreNameBox" Text="Optimal checkpoint" Margin="0,20,0,0" />
                        <TextBox Name="RestoreDescriptionBox" Text="Before manual changes" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" />
                        <TextBlock Name="RestoreStatusText" Text="System Protection must be enabled on the Windows drive." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22" Margin="9,0,0,0" Background="{StaticResource HeroGradient}">
                      <StackPanel>
                        <TextBlock Text="WHY CHECKPOINTS MATTER" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="Every Optimal write requires one." FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="✓  Protects system configuration" Margin="0,20,0,0" />
                        <TextBlock Text="✓  Created before apply or undo" Margin="0,12,0,0" />
                        <TextBlock Text="✓  Paired with exact run backups" Margin="0,12,0,0" />
                        <TextBlock Text="Restore points do not replace a file backup." Foreground="{StaticResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,20,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="OPTIMAL RESTORE CATALOG" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="Each card is a journaled run with captured pre-change state." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open Windows System Restore" Tag="rstrui.exe" Style="{StaticResource SecondaryButton}" Click="OpenWindowsTool_Click" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding HistoryRows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="286" Padding="18" Margin="0,0,12,12">
                          <StackPanel>
                            <Border Height="5" CornerRadius="3" Background="{StaticResource AccentGradient}" Margin="-18,-18,-18,14" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" Text="{Binding Date}" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,14" Text="{Binding Summary}" />
                            <Button Content="Restore captured state" Style="{StaticResource SecondaryButton}" Tag="{Binding Record}" IsEnabled="{Binding CanRevert}" Click="UndoRun_Click" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
          <Grid Name="SystemPage" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid MaxWidth="870" Margin="48,38">
                <StackPanel>
                  <TextBlock Text="THIS PC" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Know what Optimal sees." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" />
                  <TextBlock Text="Machine gates prevent incompatible tweaks from reaching execution." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,28" />
                  <UniformGrid Columns="2">
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,10,10">
                      <StackPanel>
                        <TextBlock Text="WINDOWS" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                        <TextBlock Name="SystemOsText" Text="Scanning…" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="10,0,0,10">
                      <StackPanel>
                        <TextBlock Text="PROCESSOR" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                        <TextBlock Name="SystemCpuText" Text="Scanning…" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,10,10,0">
                      <StackPanel>
                        <TextBlock Text="GRAPHICS" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                        <TextBlock Name="SystemGpuText" Text="Scanning…" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="10,10,0,0">
                      <StackPanel>
                        <TextBlock Text="MEMORY + STORAGE" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                        <TextBlock Name="SystemMemoryText" Text="Scanning…" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
          <Grid Name="AboutPage" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid MaxWidth="900" Margin="44,34">
                <StackPanel>
                  <TextBlock Text="ABOUT OPTIMAL" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Transparent tuning, built to be undone." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" />
                  <TextBlock Text="A Windows control center that explains the effect, evidence, tradeoff, and reversal before it writes anything." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                  <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.25*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="26" Margin="0,0,9,0" Background="{StaticResource HeroGradient}">
                      <StackPanel>
                        <Image Source="Assets/OptimalLogo.png" Width="190" Height="86" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Version 1.0 stable" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" Margin="0,20,0,0" />
                        <TextBlock Text="Every manifest is validated, current state is detected, and a fresh restore point plus exact undo journal is required for each write. Nothing is selected or applied automatically." Foreground="#C5CFDC" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24" Margin="9,0,0,0">
                      <StackPanel>
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" FontSize="26" />
                        <TextBlock Text="Join our Discord" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="Get release updates, share hardware results, request controls, and help test premium features." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,18" />
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Open Discord  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OpenDiscord_Click" />
                          <Button Content="Replay onboarding" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="10,0,0,0" Click="ReplayOnboarding_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock Text="PREMIUM ROADMAP" Foreground="{StaticResource PurpleBrush}" FontSize="10" FontWeight="Bold" Margin="0,28,0,10" />
                  <UniformGrid Columns="3">
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,7,0">
                      <StackPanel>
                        <TextBlock Text="Hardware profiles" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Deeper CPU/GPU-specific recommendations with measured baselines and profile exports." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="PLANNED" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" Margin="0,16,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="7,0">
                      <StackPanel>
                        <TextBlock Text="Automation schedules" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Maintenance routines with previewable targets, storage estimates, and exact run history." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="PLANNED" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" Margin="0,16,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="7,0,0,0">
                      <StackPanel>
                        <TextBlock Text="Saved game setups" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Reusable per-game Windows, NVIDIA, power, and software plans with one-click reversal." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="PLANNED" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" Margin="0,16,0,0" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                  <Border Background="#101925" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,20,0,0">
                    <TextBlock Text="Privacy: settings, backups, and run history stay on this PC. Optimal has no account requirement and contains no personal branding." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
          <Border Name="LoadingVeil" Background="#F5070A10" Visibility="Visible">
            <Border Width="448" Padding="28" Background="#F9141A25" BorderBrush="#34445E" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="12" Opacity="0.42" />
              </Border.Effect>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource AccentGradient}">
                    <Image Source="Assets/Optimal Symbol.png" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="OPTIMAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Preparing your control center" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
                <Border Height="3" CornerRadius="2" Background="#273247" Margin="0,24,0,0" ClipToBounds="True">
                  <Border Width="118" HorizontalAlignment="Left" Background="{StaticResource AccentGradient}" CornerRadius="2" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><TranslateTransform X="-118" /></Border.RenderTransform>
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-118" To="448" Duration="0:0:1.2" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>
                  </Border>
                </Border>
                <Grid Margin="0,16,0,0">
                  <TextBlock Name="LoadingText" Text="Profiling this PC and validating manifests…" Foreground="#B1BDCD" FontSize="11" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="LOCAL ONLY" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold" Margin="7,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
